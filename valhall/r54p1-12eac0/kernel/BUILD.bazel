load(
    "@kleaf//build/kernel/kleaf:kernel.bzl",
    "ddk_headers",
    "kernel_module_group",
)

package(
    default_visibility = [
        "//:__subpackages__",
        "@kleaf//common:__pkg__",
    ],
)

ddk_headers(
    name = "kernel_headers",
    hdrs = glob([
        "include/**/*.h",
    ]),
    includes = [
        "include",
        "include/linux",
    ],
)

filegroup(
    name = "kconfigs",
    srcs = [
        "//driver_modules/gpu/valhall/r54p1-12eac0/kernel/drivers/base/arm:base_kconfig",
        "//driver_modules/gpu/valhall/r54p1-12eac0/kernel/drivers/gpu/arm:gpu_kconfig",
    ],
)

kernel_module_group(
    name = "modules",
    srcs = [
        "//driver_modules/gpu/valhall/r54p1-12eac0/kernel/drivers/base/arm:base",
        "//driver_modules/gpu/valhall/r54p1-12eac0/kernel/drivers/gpu/arm:gpu",
    ] + select({
        "//driver_modules/gpu/valhall/r54p1-12eac0/kernel/config:xen_arbiter": ["//drivers/xen/arm:xen_module"],
        "//conditions:default": [],
    }),
)
